@baseUrl = https://one3-sprint-mission-be-9guw.onrender.com
@articleId = 1
@commentId = 1

### 게시글 목록 조회 (최신순)
GET {{baseUrl}}/articles?page=1&pageSize=10&orderBy=recent

### 게시글 목록 조회 (좋아요순)
GET {{baseUrl}}/articles?page=1&pageSize=10&orderBy=like

### 게시글 목록 조회 (검색)
GET {{baseUrl}}/articles?page=1&pageSize=10&keyword=테스트

### 베스트 게시글 조회 (최신 3개)
GET {{baseUrl}}/articles?page=1&pageSize=3

### 게시글 상세 조회
GET {{baseUrl}}/articles/{{articleId}}

### 게시글 등록
POST {{baseUrl}}/articles
Content-Type: application/json

{
  "title": "테스트 제목",
  "content": "테스트 내용"
}

### 게시글 수정
PATCH {{baseUrl}}/articles/{{articleId}}
Content-Type: application/json

{
  "title": "수정된 제목",
  "content": "수정된 내용"
}

### 게시글 삭제
DELETE {{baseUrl}}/articles/{{articleId}}

### 댓글 목록 조회
GET {{baseUrl}}/articles/{{articleId}}/comments

### 댓글 등록
POST {{baseUrl}}/articles/{{articleId}}/comments
Content-Type: application/json

{
  "content": "테스트 댓글"
}

### 댓글 수정
PATCH {{baseUrl}}/articles/comments/{{commentId}}
Content-Type: application/json

{
  "content": "수정된 댓글"
}

### 댓글 삭제
DELETE {{baseUrl}}/articles/comments/{{commentId}}
