# ── 로컬 개발 ────────────────────────────────────────────
# 백엔드를 직접 호출한다. (BACKEND_ORIGIN을 두지 않으므로 프록시는 동작하지 않음)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Vercel 배포 시 (대시보드 환경 변수에 설정) ──────────────
# NEXT_PUBLIC_API_URL=/api
# BACKEND_ORIGIN=http://54.180.25.232
#
# Vercel은 HTTPS인데 백엔드가 HTTP라 브라우저가 직접 호출하면 Mixed Content로 차단된다.
# 브라우저는 같은 출처(/api)로만 요청하고, Vercel 서버가 BACKEND_ORIGIN으로 대신 전달한다.
